<Window x:Class="CyberBotGUI.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Quiz" Height="500" Width="600"
        Background="#1E1E2E" Foreground="White" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="QuestionText" Grid.Row="0" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,20"/>
        <StackPanel Grid.Row="1">
            <Button x:Name="OptionAButton" Click="AnswerClicked" Height="40" Background="#3A3A4A" Foreground="White" Margin="0,0,0,10"/>
            <Button x:Name="OptionBButton" Click="AnswerClicked" Height="40" Background="#3A3A4A" Foreground="White" Margin="0,0,0,10"/>
            <Button x:Name="OptionCButton" Click="AnswerClicked" Height="40" Background="#3A3A4A" Foreground="White"/>
        </StackPanel>
        <TextBlock x:Name="FeedbackText" Grid.Row="2" FontSize="16" TextWrapping="Wrap" Margin="0,20,0,0"/>
        <Button x:Name="NextButton" Grid.Row="3" Content="Next Question" Width="150" Height="40" 
                HorizontalAlignment="Right" Click="NextClicked" Background="#00FFCC" Foreground="Black" FontWeight="Bold"/>
    </Grid>
</Window>