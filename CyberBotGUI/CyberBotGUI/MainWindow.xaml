<Window x:Class="CyberBotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" Height="650" Width="950"
        Background="#1E1E2E" Foreground="White" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE: CHATBOT -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#2A2A3A" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                <TextBlock x:Name="AsciiArtHeader" FontFamily="Consolas" FontSize="11" TextAlignment="Center" Foreground="#00FFCC" Margin="0,0,0,5"/>
            </Border>
            <ListBox x:Name="ChatHistory" Grid.Row="1" Margin="0,0,0,10" FontSize="14" Background="#2A2A3A" Foreground="White" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="5" LineHeight="22"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UserInput" Grid.Column="0" Height="40" FontSize="14" Background="#3A3A4A" Foreground="White" BorderBrush="#00FFCC" BorderThickness="1" KeyDown="UserInput_KeyDown" Padding="10" VerticalContentAlignment="Center"/>
                <Button x:Name="SendButton" Grid.Column="1" Content="Send ➤" Width="100" Height="40" Margin="10,0,0,0" Background="#00FFCC" Foreground="Black" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="SendButton_Click"/>
            </Grid>
        </Grid>

        <!-- RIGHT SIDE: TASK MANAGER -->
        <Border Grid.Column="1" Background="#2A2A3A" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="📋 Task Manager" FontSize="18" FontWeight="Bold" Foreground="#00FFCC" Margin="0,0,0,10"/>
                <ListBox x:Name="TaskListBox" Grid.Row="1" Background="#1E1E2E" Foreground="White" BorderThickness="0" Margin="0,0,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Margin="5"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2">
                    <Button Content="🔄 Refresh Tasks" Background="#3A3A4A" Foreground="White" Click="RefreshTasks_Click" Height="35" Margin="0,0,0,5"/>
                    <Button Content="✔ Mark as Completed" Background="#00FFCC" Foreground="Black" Click="CompleteTask_Click" Height="35" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Button Content="🗑 Delete Task" Background="#FF5555" Foreground="White" Click="DeleteTask_Click" Height="35" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>