<Window x:Class="CyberBotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" Height="650" Width="850"
        Background="#1E1E2E" Foreground="White" WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header / ASCII Art -->
            <RowDefinition Height="*"/>
            <!-- Chat History -->
            <RowDefinition Height="Auto"/>
            <!-- Input Area -->
        </Grid.RowDefinitions>

        <!-- Header: ASCII Art and Voice Greeting Status -->
        <Border Grid.Row="0" Background="#2A2A3A" CornerRadius="8" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock x:Name="AsciiArtHeader" FontFamily="Consolas" FontSize="11" 
                           TextAlignment="Center" Foreground="#00FFCC" Margin="0,0,0,5"/>
                <TextBlock x:Name="StatusText" Text="🔊 Voice Greeting Played" FontSize="10" 
                           Foreground="LightGray" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Chat Display Area -->
        <ListBox x:Name="ChatHistory" Grid.Row="1" Margin="0,0,0,15" FontSize="14"
                 Background="#2A2A3A" Foreground="White" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="5" 
                               LineHeight="22"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Input Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UserInput" Grid.Column="0" Height="40" FontSize="14" 
                     Background="#3A3A4A" Foreground="White" BorderBrush="#00FFCC"
                     BorderThickness="1" KeyDown="UserInput_KeyDown" Padding="10"
                     VerticalContentAlignment="Center"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="Send ➤" Width="100" 
                    Height="40" Margin="10,0,0,0" Background="#00FFCC" Foreground="Black"
                    FontWeight="Bold" FontSize="14" Cursor="Hand" Click="SendButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>